# ═══════════════════════════════════════════════════════════════════════
#  Airplane Edu — unified environment config (set every key in ONE place)
#  Copy this file to `.env` in this directory, then fill in your key(s):
#      cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── Shared LLM API key ─────────────────────────────────────────────────
# Used by BOTH rag_system (multi-agent RAG) and backend (direct fallback).
# Fill it in once here; no need to also edit rag_system/config.yaml or backend/.env.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Optional: OpenAI relay ─────────────────────────────────────────────
# Only needed if you switch `llm.provider` to "openai" in rag_system/config.yaml.
# OPENAI_API_KEY=your_openai_api_key_here

# ── backend service (:3001) ────────────────────────────────────────────
PORT=3001
EDGE_VOICE=en-US-GuyNeural

# ── rag_system address (backend → rag_system over HTTP) ────────────────
RAG_SYSTEM_URL=http://localhost:8000
RAG_SYSTEM_TIMEOUT=120

# ── Optional DeepSeek overrides (defaults are set in backend/main.py) ──
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
